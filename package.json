{
  "name": "yochef",
  "private": true,
  "version": "0.1.0",
  "description": "YoChef rebuild (v2): Expo mobile app, Vite admin web, Supabase migrations.",
  "scripts": {
    "install:all": "npm install && npm --prefix app install && npm --prefix admin install",
    "typecheck": "npm --prefix app run typecheck && npm --prefix admin run typecheck",
    "lint": "npm --prefix app run lint && npm --prefix admin run lint",
    "test": "npm --prefix app test && npm --prefix admin test",
    "check": "npm run typecheck && npm run lint && npm test",
    "supabase": "supabase",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "db:push": "node scripts/sb.mjs db push",
    "db:list": "node scripts/sb.mjs migration list",
    "db:advisors": "node scripts/sb.mjs db advisors",
    "db:verify": "node scripts/db_verify.mjs --log docs/evidence/phase-4/db_verify.log",
    "seed:build": "node supabase/seed/import_recipes.mjs",
    "smoke:live": "node --env-file=app/.env scripts/live_smoke.mjs --log docs/evidence/phase-0/live_smoke.log",
    "smoke:auth": "node --env-file=app/.env --env-file-if-exists=.env.smoke scripts/live_auth_smoke.mjs --log docs/evidence/phase-1/live_auth_smoke.log",
    "smoke:recipes": "node --env-file=app/.env scripts/live_recipes_smoke.mjs --log docs/evidence/phase-2/live_recipes_smoke.log",
    "smoke:user": "node --env-file=app/.env --env-file-if-exists=.env.smoke scripts/live_user_smoke.mjs --log docs/evidence/phase-4/live_user_smoke.log",
    "smoke:admin": "node --env-file=app/.env --env-file-if-exists=.env.smoke scripts/live_admin_smoke.mjs --log docs/evidence/phase-4/live_admin_smoke.log"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "supabase": "2.122.0"
  },
  "engines": {
    "node": ">=22"
  }
}
