# YoChef admin web: environment template
# Copy to admin/.env (git-ignored). Every VITE_* value ships inside the browser bundle,
# so ONLY public values belong here: the project URL and the publishable key.
# NEVER put a secret key (sb_secret_...), the service_role key, a database password,
# or YouTube/USDA keys here. Provider keys live in Edge Function secrets.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
