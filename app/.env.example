# YoChef mobile app: environment template
# Copy to app/.env (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app,
# so ONLY public values belong here: the project URL and the publishable key.
# NEVER put a secret key (sb_secret_...), the service_role key or a database password here.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
